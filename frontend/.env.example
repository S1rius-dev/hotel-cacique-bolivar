# Variables de entorno del frontend (ejemplo versionable).
# Copia este archivo a .env para desarrollo local:  Copy-Item .env.example .env
#
# NINGÚN valor real debe ir aquí. Usa tus propios identificadores.

# URL base de la API REST.
# Si se omite, el frontend la detecta por hostname: localhost -> http://localhost:8080.
# VITE_API_URL=http://localhost:8080

# Identificador de cliente OAuth de Google (opcional).
# Sin este valor, el botón de inicio de sesión con Google queda deshabilitado;
# el login local del staff (correo + contraseña) sigue funcionando.
# VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
