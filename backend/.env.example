# Hotel Cacique Bolívar — Variables de entorno (ejemplo versionable)
# Copia este archivo a .env para desarrollo local:  Copy-Item .env.example .env
# No pongas secretos reales aquí; usa CHANGEME y reemplázalos en tu .env local.
# En producción (Windows Server) usa Variables de entorno del sistema, NO .env.

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotelcaciquebolivar
DB_USERNAME=root
DB_PASSWORD=CHANGEME

JPA_DDL_AUTO=update
HIBERNATE_FORMAT_SQL=false

LOG_LEVEL_SQL=debug
LOG_LEVEL_BINDER=trace

SERVER_PORT=8080

JWT_SECRET=ZGVtby1vbmx5LWp3dC1zZWNyZXQtZG8tbm90LXVzZS1pbi1wcm9kdWN0aW9uLTAxMjM0NTY3ODk=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

GOOGLE_CLIENT_ID=CHANGEME

COOKIE_SECURE=false

# Orígenes permitidos para CORS (separados por coma). Solo el frontend local por defecto.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# En la demo se deshabilita: no se importa ningún CSV de clientes reales.
MIGRACION_CLIENTES_AUTO=false

ADMIN_EMAIL=CHANGEME
ADMIN_USERNAME=CHANGEME
ADMIN_PASSWORD=CHANGEME

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM=CHANGEME
MAIL_SENDER_NAME=Hotel Cacique Bolívar
APP_BASE_URL=http://localhost:5173
MAIL_LOGO_URL=http://localhost:8080/images/logo.png

PAYMENTS_GATEWAY=wompi
PAYMENTS_CURRENCY=COP
WOMPI_PUBLIC_KEY=CHANGEME
WOMPI_PRIVATE_KEY=CHANGEME
WOMPI_EVENTS_KEY=CHANGEME
WOMPI_INTEGRITY_KEY=CHANGEME
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=http://localhost:5173/pago/exito
WOMPI_WEBHOOK_URL=CHANGEME
BOLD_IDENTITY_KEY=CHANGEME
BOLD_SECRET_KEY=CHANGEME
BOLD_WEBHOOK_URL=CHANGEME

PAYMENT_EXPIRATION_MINUTES=20

# ── Copias de seguridad ───────────────────────────────────────────────
# Ver docs/backup-runbook.md. La restauración solo se expone como CLON a una
# base nueva (POST /api/backups/{id}/clonar); nunca sobre la base de la app.
BACKUP_ENABLED=false
# En Windows ni mysqldump ni mysql suelen estar en PATH; usa rutas completas:
# MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_STORAGE_DIR=./backups
BACKUP_STORAGE_PROVIDER=local
BACKUP_TIMEOUT_SECONDS=1800
# El clonado importa más datos que los que vuelca, así que va con más holgura
BACKUP_CLON_TIMEOUT_SECONDS=3600
BACKUP_CLON_DEFAULT_PREFIX=hotel_restaurada_
# Copia automática: 2 AM hora de Bogotá, todos los días
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_CRON=0 0 2 * * *
BACKUP_SCHEDULE_ZONE=America/Bogota
BACKUP_CLEANUP_ENABLED=true
BACKUP_CLEANUP_CRON=0 30 3 * * *
# Retención en días; -1 significa que nunca se borra
BACKUP_RETENTION_AUTOMATIC_DAYS=30
BACKUP_RETENTION_MANUAL_DAYS=-1
